# Gemini -- two auth paths, selected by GOOGLE_GENAI_USE_VERTEXAI.
#   TRUE  (Vertex AI, real quota): needs GOOGLE_CLOUD_PROJECT and
#         GOOGLE_CLOUD_LOCATION. Auth via Application Default
#         Credentials (a service account in deployment) -- no API key.
#   FALSE (Developer API, 20 requests/day free tier): needs
#         GOOGLE_API_KEY. GOOGLE_CLOUD_PROJECT/LOCATION are unused.
GOOGLE_GENAI_USE_VERTEXAI=
GOOGLE_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=
GEMINI_MODEL=

# Grafana — dashboards, alerts, MCP
GRAFANA_URL=
GRAFANA_SERVICE_ACCOUNT_TOKEN=

# OTLP ingest
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_EXPORTER_OTLP_PROTOCOL=
